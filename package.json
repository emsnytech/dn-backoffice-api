{
  "name": "dn-backoffice-api",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node --env-file=.env scripts/fetch-demarche.ts",
    "dev:server": "node --env-file=.env --watch server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "copy-dsfr-to-public",
    "predev:web": "only-include-used-icons",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.36.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
